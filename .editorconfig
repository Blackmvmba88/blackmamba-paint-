# BlackMamba Paint - EditorConfig
# Universal editor configuration for consistent code style
# https://editorconfig.org

root = true

# Default for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Rust files
[*.rs]
indent_size = 4
max_line_length = 100

# TOML files
[*.toml]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# Markdown files
[*.md]
indent_size = 2
trim_trailing_whitespace = false  # Markdown uses trailing spaces for line breaks

# YAML files (GitHub Actions, etc)
[*.{yml,yaml}]
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 2
charset = utf-8
end_of_line = lf
